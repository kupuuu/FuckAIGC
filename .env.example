# Copy this file to .env and fill in your own values.

# OpenAI-compatible model config used by the rewriter.
ENHANCE_MODEL=gemini-2.5-pro
ENHANCE_API_KEY=your-api-key-here
ENHANCE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional generic fallback config.
# OPENAI_API_KEY=your-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional local server port.
# REWRITER_PORT=7860
